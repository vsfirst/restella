# 로컬 개발용 예시 값. 복사해서 .env.local로 쓴다 (커밋하지 않는다, docs/2-design/security.md)
# 배포 환경(demo, prod)에서는 Secrets Manager → External Secrets Operator로 주입한다

# 실행 환경: local, demo, prod
# local이 아니면 back-end를 클러스터 내부 주소(http://api.restella.svc.cluster.local:3000)로 부르고 BACKEND_URL은 쓰지 않는다
APP_ENV=local

# back-end 주소 (APP_ENV=local일 때만). 서버(BFF·서버 렌더링)에서만 쓰고 브라우저로 나가지 않는다
# 호스트에서 pnpm dev로 실행하면 http://localhost:3100. Docker compose는 http://back-end:3000으로 덮어쓴다
BACKEND_URL=http://localhost:3100

# iron-session 쿠키 암호화 키 (32자 이상). 예: openssl rand -base64 32
SESSION_SECRET=local-only-session-secret-change-me-0000
