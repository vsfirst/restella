# 로컬 Docker 전체 실행용 예시 (compose.yaml). 복사해서 .env로 쓴다 (.env는 커밋하지 않는다)
# 아래 값은 모두 로컬 예시이며 운영에서 쓰지 않는다

# MariaDB
DB_NAME=restella
DB_USER=restella
DB_PASSWORD=change-me-local-only
DB_PORT=3306

# back-end (32자 이상 임의 문자열. 예: openssl rand -hex 32)
JWT_SECRET=local-only-jwt-secret-change-me-0000000000
JWT_TTL_SECONDS=28800
# 채널별 웹훅 서명 키 (각 32자 이상). JSON은 작은따옴표로 감싼다
CHANNEL_SECRETS_JSON='{"DIRECT":"local-only-direct-secret-000000000000","APPROVAL":"local-only-approval-secret-0000000000","OTA_A":"local-only-ota-a-secret-00000000000000","OTA_B":"local-only-ota-b-secret-00000000000000","OTA_C":"local-only-ota-c-secret-00000000000000"}'
OUTBOUND_SIGNING_SECRET=local-only-outbound-secret-change-me-000
# 장애 주입 (비우면 정상). 예: '{"OTA_C":{"failureRate":0.3,"delayMs":0}}'
SIMULATOR_FAULTS_JSON=
# 시드가 만드는 데모 운영자(demo-operator)의 비밀번호
SEED_OPERATOR_PASSWORD=change-me-local-only

# 내 컴퓨터에서 접속할 포트
BACK_END_PORT=3100
FRONT_END_PORT=3200

# front-end 값(APP_ENV, SESSION_SECRET)은 front-end/.env.local에 둔다 (front-end/.env.example 참고)
