# 로컬 개발용 예시. 복사해서 .env로 쓴다 (.env는 커밋하지 않는다).
# 아래 값은 모두 예시이며 운영에서 쓰지 않는다. 운영 값은 Secrets Manager(restella-demo)에 있다.
NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=restella
DB_PASSWORD=change-me-local-only
DB_NAME=restella

# 32자 이상 임의 문자열 (예: openssl rand -hex 32)
JWT_SECRET=change-me-local-only-change-me-local-only
JWT_TTL_SECONDS=28800

# 채널별 웹훅 서명 키 (각 32자 이상)
CHANNEL_SECRETS_JSON='{"DIRECT":"local-direct-secret-0000000000000000","APPROVAL":"local-approval-secret-00000000000000","OTA_A":"local-ota-a-secret-000000000000000000","OTA_B":"local-ota-b-secret-000000000000000000","OTA_C":"local-ota-c-secret-000000000000000000"}'
OUTBOUND_SIGNING_SECRET=local-outbound-secret-0000000000000000

# 시뮬레이터가 예약을 보낼 주소 (자기 자신)
SIMULATOR_TARGET_URL=http://localhost:3000
# 장애 주입 예: {"OTA_C":{"failureRate":0.3,"delayMs":0}}
SIMULATOR_FAULTS_JSON='{}'

# 시드 실행 시에만 쓰는 데모 운영자 비밀번호
SEED_OPERATOR_PASSWORD=change-me-local-only
